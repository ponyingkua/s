name: Backtest Batch (manual)

on:
  workflow_dispatch:
    inputs:
      symbols:
        description: "Simbol dipisah koma (kosongkan untuk pakai 10 coin default)"
        default: ""
      timeframe:
        description: "Timeframe, contoh: 15m / 1h / 4h"
        default: "1h"
        required: true

jobs:
  backtest_batch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Jalankan backtest batch
        run: |
          if [ -z "${{ github.event.inputs.symbols }}" ]; then
            PYTHONPATH=src python run_backtest_batch.py \
              --timeframe "${{ github.event.inputs.timeframe }}"
          else
            PYTHONPATH=src python run_backtest_batch.py \
              --symbols "${{ github.event.inputs.symbols }}" \
              --timeframe "${{ github.event.inputs.timeframe }}"
          fi

      - name: Commit hasil backtest batch
        run: |
          git config user.name "vsynapse-bot"
          git config user.email "bot@users.noreply.github.com"
          git add backtest_batch_result.md
          git diff --quiet --cached || git commit -m "chore: batch backtest ${{ github.event.inputs.timeframe }}"
          git push